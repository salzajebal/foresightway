[Unit]
Description=Back up Foresightway IPO images off-site
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/flock --nonblock /run/foresightway-ipo-image-backup/job.lock /usr/local/sbin/foresightway-ipo-image-backup
User=root
Group=root
RuntimeDirectory=foresightway-ipo-image-backup
RuntimeDirectoryMode=0750
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
StateDirectory=foresightway/ipo-image-backups
StateDirectoryMode=0750
Nice=10
